# Backend API environment configuration for ChargeMate (FastAPI)

# Core
API_BASE_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,http://10.0.2.2:3001
ENV=development
PORT=3001

# Security
JWT_SECRET=changeme_please_use_a_long_random_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Supabase (Auth + Postgres)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://user:password@host:5432/dbname

# Database (if connecting directly rather than through Supabase proxy)
POSTGRES_URL=postgresql://localhost:5000/myapp
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp
POSTGRES_PORT=5000

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_CURRENCY=usd

# Notifications (FCM)
FCM_SERVER_KEY=AAAA_xxx
# Optional topic for broadcast notifications
FCM_DEFAULT_TOPIC=general

# Maps
MAPS_API_KEY=your_google_maps_api_key

# Email/External (optional placeholders for future expansion)
SENDGRID_API_KEY=
MAIL_FROM=noreply@chargemate.app
MAIL_FROM_NAME=ChargeMate

# Logging
LOG_LEVEL=INFO

# Notes:
# - Do NOT commit real secrets; copy this file to .env and populate values.
# - ALLOWED_ORIGINS should include client app origins for CORS.
